{
  "name": "dsh-mcp-manager",
  "version": "0.1.0",
  "private": true,
  "description": "DSH Web 客户端插件：在设置界面底部提供 MCP 服务器的可视化管理（增删改、启停、连通状态）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "node tools/build.mjs",
    "typecheck": "tsc -b --clean && tsc -b",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tools/**/*.mjs\" \"*.{json,js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tools/**/*.mjs\" \"*.{json,js,mjs}\"",
    "verify": "node tools/verify.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm build && pnpm verify"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
