{
  "name": "@qq540491950/dsh-mcp-manager",
  "version": "0.4.1",
  "description": "在 DSH 设置页可视化管理 profile 里的 MCP 顶层条目：增删改、启停、连通探测与工具名单。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "mcp",
    "settings"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/qq540491950/dsh-mcp-manager.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/host/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/host/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "icon": "./assets/icon.svg",
  "files": [
    "lib",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/icon.svg",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "engines": {
    "node": ">=22.18",
    "dsh": "^0.2.0-rc.2"
  },
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "build": "node tools/build.ts",
    "typecheck": "tsc -b --clean && tsc -b",
    "typecheck:tools": "tsc -p tsconfig.tools.json",
    "typecheck:tools:wip": "tsc -p tsconfig.tools.wip.json",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.{ts,tsx}\" \"tools/**/*.ts\" \"*.{json,js,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx}\" \"tools/**/*.ts\" \"*.{json,js,mjs}\"",
    "verify": "node tools/verify.ts",
    "check": "pnpm typecheck && pnpm typecheck:tools && pnpm lint && pnpm format:check && pnpm build && pnpm verify"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.4"
  },
  "devDependencies": {
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^26.6.5",
    "@types/react": "~18.3.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "js-yaml": "^5.5.0",
    "prettier": "^3.9.10",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.2"
  }
}
